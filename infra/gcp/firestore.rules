// DenialDefender Firestore Security Rules
// Deploy: firebase deploy --only firestore:rules
// Policy: Deny all client access — only service-account writes allowed
// This enforces the Day 1 gate: all data access goes through the API service

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Collections: cases, denials, outcomes, decision_trace_events, hitl_gates
    // All access is via the api Cloud Run service using service-account credentials
    // Client-side reads/writes are explicitly denied
    
    match /cases/{caseId} {
      allow read, write: if false;
    }
    
    match /denials/{denialId} {
      allow read, write: if false;
    }
    
    match /outcomes/{outcomeId} {
      allow read, write: if false;
    }
    
    match /decision_trace_events/{eventId} {
      allow read, write: if false;
    }
    
    match /hitl_gates/{gateId} {
      allow read, write: if false;
    }
    
    // Catch-all: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
