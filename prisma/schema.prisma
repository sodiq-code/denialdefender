// DenialDefender - Medical Insurance Denial Appeal System
// Core Data Model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum CaseState {
  created
  triage_active
  triage_complete
  hitl_gate_1
  evidence_active
  drafting_active
  quality_review
  hitl_gate_2
  approved
  submitted
  won
  lost
}

enum DenialCategory {
  medical_necessity
  coding
  prior_auth
  experimental
  out_of_network
  other
}

enum ProvenanceTier {
  primary_source
  secondary_summary
  tertiary_commentary
}

enum EvidenceStatus {
  active
  superseded
  retired
}

enum CitationStatus {
  verified
  unverified
  disputed
  unsupported
}

enum OutcomeVerdict {
  won
  lost
  partial
  pending
}

enum OutcomeLevel {
  initial
  first_appeal
  second_appeal
  external_review
}

enum TraceStatus {
  started
  completed
  error
  blocked
}

enum HitlGateStatus {
  pending
  approved
  rejected
  edited
}

// ============================================
// CORE ENTITIES
// ============================================

model Case {
  id         String     @id @default(cuid())
  patient_id String     // hashed patient identifier
  state      CaseState  @default(created)
  deadline   DateTime?
  persona    String?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  // Relations
  denial    Denial?
  outcomes  Outcome[]
  traces    DecisionTraceEvent[]
  gates     HitlGate[]
}

model Denial {
  id                 String         @id @default(cuid())
  case_id            String         @unique
  payer              String
  reason_code        String
  category           DenialCategory
  denial_letter_text String
  deadline           DateTime?
  confidence         Float?
  structured_json    String?
  created_at         DateTime       @default(now())

  // Relations
  case    Case     @relation(fields: [case_id], references: [id], onDelete: Cascade)
}

model Evidence {
  id              String         @id @default(cuid())
  source          String
  document_name   String
  section         String?
  effective_date  DateTime?
  content_hash    String?
  embedding       String?        // text for now, pgvector later
  provenance_tier ProvenanceTier @default(primary_source)
  status          EvidenceStatus @default(active)
  retrieved_date  DateTime       @default(now())
  content         String
  created_at      DateTime       @default(now())

  // Relations
  citations Citation[]
}

model Citation {
  id          String         @id @default(cuid())
  evidence_id String
  span_start  Int
  span_end    Int
  claim_text  String
  status      CitationStatus @default(unverified)
  created_at  DateTime       @default(now())

  // Relations
  evidence Evidence @relation(fields: [evidence_id], references: [id], onDelete: Cascade)
}

model Outcome {
  id          String         @id @default(cuid())
  case_id     String
  verdict     OutcomeVerdict @default(pending)
  level       OutcomeLevel   @default(initial)
  recorded_at DateTime       @default(now())

  // Relations
  case Case @relation(fields: [case_id], references: [id], onDelete: Cascade)
}

model DecisionTraceEvent {
  id         String      @id @default(cuid())
  case_id    String
  agent_name String
  step       String
  status     TraceStatus @default(started)
  details    String?     // JSON string
  references String?     // JSON string
  timestamp  DateTime    @default(now())

  // Relations
  case Case @relation(fields: [case_id], references: [id], onDelete: Cascade)
}

model HitlGate {
  id            String         @id @default(cuid())
  case_id       String
  gate_number   Int            // 1 or 2
  status        HitlGateStatus @default(pending)
  reviewer_note String?
  resolved_at   DateTime?
  created_at    DateTime       @default(now())

  // Relations
  case Case @relation(fields: [case_id], references: [id], onDelete: Cascade)
}
